---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagCount = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`全部文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<h1 class="page-title">全部货架</h1>
				<p class="page-sub">共 {posts.length} 件货 · 每日上新</p>
			</div>

			{
				tags.length > 0 && (
					<div class="tag-cloud">
						{tags.map(([tag, count]) => (
							<span class="tag">
								{tag}
								<span class="tag-count">{count}</span>
							</span>
						))}
					</div>
				)
			}

			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="post-card">
							<a href={`/blog/${post.id}/`} class="post-link">
								<div class="post-main">
									<h3 class="post-title">{post.data.title}</h3>
									<p class="post-desc">{post.data.description}</p>
								</div>
								<div class="post-meta">
									<div class="post-tags">
										{post.data.tags.map((tag) => (
											<span class="tag">{tag}</span>
										))}
									</div>
									<time class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</time>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 860px;
	}
	.page-head {
		margin-bottom: 1.6em;
	}
	.page-title {
		font-size: 2rem;
		margin: 0 0 0.3em;
	}
	.page-sub {
		color: var(--ink-faint);
		font-size: 0.9rem;
		margin: 0;
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2em;
	}
	.tag {
		font-size: 0.8rem;
		color: var(--cinnabar-dark);
		background: var(--cinnabar-wash);
		padding: 0.2em 0.85em;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}
	.tag-count {
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1em;
	}
	.post-card {
		background: var(--paper-card);
		border: 1px solid var(--border);
		border-radius: 12px;
		transition:
			border-color 0.18s ease,
			box-shadow 0.18s ease,
			transform 0.18s ease;
	}
	.post-card:hover {
		border-color: var(--border-strong);
		box-shadow: var(--shadow);
		transform: translateY(-2px);
	}
	.post-link {
		display: flex;
		justify-content: space-between;
		gap: 1.5em;
		padding: 1.15em 1.45em;
		text-decoration: none;
		border-bottom: none;
	}
	.post-main {
		flex: 1;
		min-width: 0;
	}
	.post-title {
		font-size: 1.2rem;
		margin: 0 0 0.35em;
		color: var(--ink);
	}
	.post-card:hover .post-title {
		color: var(--cinnabar-dark);
	}
	.post-desc {
		margin: 0;
		color: var(--ink-light);
		font-size: 0.9rem;
		line-height: 1.65;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.5em;
		flex-shrink: 0;
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		justify-content: flex-end;
	}
	.post-tags .tag {
		background: var(--cinnabar-wash);
	}
	.post-date {
		color: var(--ink-faint);
		font-size: 0.78rem;
		white-space: nowrap;
	}

	@media (max-width: 720px) {
		main {
			width: 100%;
		}
		.page-title {
			font-size: 1.6rem;
		}
		.post-link {
			flex-direction: column;
			gap: 0.6em;
		}
		.post-meta {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			width: 100%;
		}
		.post-tags {
			justify-content: flex-start;
		}
	}
</style>
