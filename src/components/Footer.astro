---
const today = new Date();
const startYear = 2016;
const years = today.getFullYear() - startYear;
---

<footer>
	<p>
		&copy; 2016-{today.getFullYear()} 董掌柜 · 本铺已开张 {years} 年（中间歇业了 {years - 1} 年，嘘 🤫）
	</p>
	<p class="rss-hint">
		<a href="/rss.xml">RSS 订阅</a> ·
		<a href="https://github.com/ddccisme" target="_blank">GitHub</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0.5em 0;
		font-size: 0.85em;
	}
	footer a {
		color: rgb(var(--gray));
	}
	footer a:hover {
		color: var(--accent);
	}
</style>
