---
const today = new Date();
const startYear = 2016;
const years = today.getFullYear() - startYear;
---

<footer>
	<div class="footer-rule" aria-hidden="true">
		<span></span>
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path
				fill="currentColor"
				d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2c1.6 0 3 .5 4.2 1.3L5.3 16.2A8 8 0 0 1 12 4zm0 16a8 8 0 0 1-4.2-1.3L18.7 7.8A8 8 0 0 1 12 20z"
				opacity="0.35"
			></path>
		</svg>
		<span></span>
	</div>
	<p class="brand-mark">董掌柜的杂货铺</p>
	<p class="meta">
		&copy; 2016–{today.getFullYear()} · 本铺开张 {years} 年（中间歇业 {years - 1}
		年，嘘 🤫）
	</p>
	<p class="links">
		<a href="/rss.xml">RSS 订阅</a>
		<span class="dot">·</span>
		<a href="https://github.com/ddccisme" target="_blank">GitHub</a>
	</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em 1em;
		background: var(--paper-deep);
		text-align: center;
	}
	.footer-rule {
		display: flex;
		align-items: center;
		gap: 0.8em;
		max-width: 320px;
		margin: 0 auto 1.6em;
		color: var(--ink-faint);
	}
	.footer-rule span {
		flex: 1;
		border-top: 1px solid var(--border-strong);
	}
	.brand-mark {
		font-family: var(--serif);
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--ink-light);
		letter-spacing: 0.35em;
		margin: 0 0 0.6em;
		text-indent: 0.35em;
	}
	.meta {
		margin: 0 0 0.5em;
		font-size: 0.82rem;
		color: var(--ink-faint);
	}
	.links {
		margin: 0;
		font-size: 0.85rem;
	}
	.links a {
		color: var(--ink-light);
	}
	.links a:hover {
		color: var(--cinnabar-dark);
	}
	.dot {
		margin: 0 0.5em;
		color: var(--ink-faint);
	}
</style>
