---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="brand">
			<span class="seal" aria-hidden="true">董</span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="social-links">
			<a href="/rss.xml" target="_blank" title="RSS 订阅">
				<span class="sr-only">RSS 订阅</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path
						fill="currentColor"
						d="M2 2v2c5.523 0 10 4.477 10 10h2C14 7.373 8.627 2 2 2zm0 4v2c3.314 0 6 2.686 6 6h2c0-4.418-3.582-8-8-8zm1.5 5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"
					></path>
				</svg>
			</a>
			<a href="https://github.com/ddccisme" target="_blank" title="GitHub">
				<span class="sr-only">去我的 GitHub 主页</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--paper) 82%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.7em 0.3em;
		text-decoration: none;
		border-bottom: none;
	}
	.seal {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.85em;
		height: 1.85em;
		background: var(--cinnabar);
		color: #fff;
		font-family: var(--serif);
		font-size: 0.95rem;
		font-weight: 700;
		border-radius: 5px;
		box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.28);
		transform: rotate(-3deg);
	}
	.brand-name {
		font-family: var(--serif);
		font-size: 1.06rem;
		font-weight: 700;
		color: var(--ink);
		letter-spacing: 0.02em;
	}
	.brand:hover .brand-name {
		color: var(--cinnabar-dark);
	}
	.internal-links {
		display: flex;
		gap: 0.2em;
	}
	nav :global(a) {
		padding: 0.85em 0.7em;
		color: var(--ink-light);
		text-decoration: none;
		border-bottom: none;
		font-size: 0.98rem;
	}
	nav :global(a:hover) {
		color: var(--cinnabar-dark);
	}
	nav :global(a.active) {
		color: var(--cinnabar);
		font-weight: 600;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.1em;
	}
	.social-links a {
		display: flex;
		padding: 0.55em;
		color: var(--ink-faint);
		border-bottom: none;
	}
	.social-links a:hover {
		color: var(--cinnabar-dark);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		nav {
			justify-content: space-between;
		}
	}
</style>
