---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = allPosts.slice(0, 5);
const totalPosts = allPosts.length;
const tagSet = new Set<string>();
for (const p of allPosts) for (const t of p.data.tags) tagSet.add(t);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-lantern" aria-hidden="true">🏮</div>
				<h1 class="hero-title">{SITE_TITLE}</h1>
				<p class="hero-slogan">「每天打烊前，往货架上添一件新货。」</p>
				<p class="hero-meta">
					大数据 &amp; AI 售前工程师的技术杂货铺 · 歇业十年，2026 年重新开张
				</p>
				<div class="hero-stats">
					<div class="stat">
						<span class="stat-num">{totalPosts}</span>
						<span class="stat-label">件存货</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat">
						<span class="stat-num">{tagSet.size}</span>
						<span class="stat-label">个货架分区</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat">
						<span class="stat-num">每日</span>
						<span class="stat-label">上新不停</span>
					</div>
				</div>
				<div class="hero-shelves">
					{['大数据', 'AI工程', '售前手艺', '工具杂货'].map((t) => (
						<span class="shelf-tag">{t}</span>
					))}
				</div>
			</section>

			<section class="new-arrival">
				<div class="section-head">
					<h2 class="section-title">今日到货</h2>
					<a href="/blog" class="section-more">逛全部货架 →</a>
				</div>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`} class="post-link">
									<div class="post-main">
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-desc">{post.data.description}</p>
									</div>
									<div class="post-meta">
										<div class="post-tags">
											{post.data.tags.map((tag) => (
												<span class="tag">{tag}</span>
											))}
										</div>
										<time class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</time>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 860px;
	}

	/* —— 招牌 Hero —— */
	.hero {
		background: linear-gradient(160deg, #2b2620 0%, #1f1b16 100%);
		border-radius: 16px;
		padding: 3em 2.2em 2.6em;
		text-align: center;
		color: #e8e0d0;
		margin-bottom: 2.8em;
		position: relative;
		overflow: hidden;
		box-shadow: var(--shadow);
	}
	.hero::after {
		content: '';
		position: absolute;
		inset: 10px;
		border: 1px solid rgba(212, 160, 100, 0.18);
		border-radius: 10px;
		pointer-events: none;
	}
	.hero-lantern {
		font-size: 2.2rem;
		margin-bottom: 0.2em;
		filter: drop-shadow(0 4px 14px rgba(184, 68, 44, 0.45));
	}
	.hero-title {
		font-family: var(--serif);
		color: #f5efe2;
		font-size: 2.3rem;
		letter-spacing: 0.14em;
		margin: 0 0 0.4em;
		text-indent: 0.14em;
	}
	.hero-slogan {
		font-family: var(--serif);
		color: #d4603f;
		font-size: 1.12rem;
		margin: 0 0 0.6em;
	}
	.hero-meta {
		color: #a89b85;
		font-size: 0.88rem;
		margin: 0 0 1.8em;
	}
	.hero-stats {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.6em;
		margin-bottom: 1.5em;
	}
	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.15em;
	}
	.stat-num {
		font-family: var(--serif);
		font-size: 1.5rem;
		font-weight: 700;
		color: #f5efe2;
	}
	.stat-label {
		font-size: 0.78rem;
		color: #a89b85;
		letter-spacing: 0.1em;
	}
	.stat-divider {
		width: 1px;
		height: 2.2em;
		background: rgba(212, 160, 100, 0.22);
	}
	.hero-shelves {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.6em;
	}
	.shelf-tag {
		font-size: 0.8rem;
		color: #d4b88a;
		border: 1px solid rgba(212, 160, 100, 0.35);
		padding: 0.22em 0.95em;
		border-radius: 999px;
		letter-spacing: 0.06em;
	}

	/* —— 今日到货 —— */
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.2em;
	}
	.section-title {
		font-size: 1.55rem;
		margin: 0;
	}
	.section-title::before {
		content: '🆕 ';
	}
	.section-more {
		font-size: 0.9rem;
		color: var(--ink-light);
		border-bottom: none;
	}
	.section-more:hover {
		color: var(--cinnabar-dark);
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1em;
	}
	.post-card {
		background: var(--paper-card);
		border: 1px solid var(--border);
		border-radius: 12px;
		transition:
			border-color 0.18s ease,
			box-shadow 0.18s ease,
			transform 0.18s ease;
	}
	.post-card:hover {
		border-color: var(--border-strong);
		box-shadow: var(--shadow);
		transform: translateY(-2px);
	}
	.post-link {
		display: flex;
		justify-content: space-between;
		gap: 1.5em;
		padding: 1.1em 1.4em;
		text-decoration: none;
		border-bottom: none;
	}
	.post-main {
		flex: 1;
		min-width: 0;
	}
	.post-title {
		font-size: 1.18rem;
		margin: 0 0 0.35em;
		color: var(--ink);
	}
	.post-card:hover .post-title {
		color: var(--cinnabar-dark);
	}
	.post-desc {
		margin: 0;
		color: var(--ink-light);
		font-size: 0.9rem;
		line-height: 1.65;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.5em;
		flex-shrink: 0;
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		justify-content: flex-end;
	}
	.tag {
		font-size: 0.72rem;
		color: var(--cinnabar-dark);
		background: var(--cinnabar-wash);
		border: 1px solid transparent;
		padding: 0.14em 0.7em;
		border-radius: 999px;
		white-space: nowrap;
	}
	.post-date {
		color: var(--ink-faint);
		font-size: 0.78rem;
		white-space: nowrap;
	}

	@media (max-width: 720px) {
		main {
			width: 100%;
		}
		.hero {
			padding: 2.2em 1.4em 2em;
		}
		.hero-title {
			font-size: 1.65rem;
		}
		.hero-stats {
			gap: 1em;
		}
		.post-link {
			flex-direction: column;
			gap: 0.6em;
		}
		.post-meta {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			width: 100%;
		}
		.post-tags {
			justify-content: flex-start;
		}
	}
</style>
